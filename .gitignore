# Potop. Everything at the top is out unless named.
/*
!/.gitignore
!/Makefile
!/README.md
!/TODO.md
!/LICENSE
!/engine/
!/game/
!/editor/
!/tools/
!/docs/
!/third_party/
!/house_plans/
!/plant_plans/
!/props_plan/
!/data/
!/tests/

# data/: all of it but what is made at run time (cache), what make shaders
# makes (spirv) and the actors (models under a license that does not allow
# them in a public repository)
/data/cache/
/data/actors/
/data/shaders/spirv/

# tools/: the sources and scripts, not what they build
/tools/*
!/tools/*.c
!/tools/*.h
!/tools/*.sh
!/tools/*.ini
!/tools/*.py

# Built anywhere
*.o
*.d
__pycache__/
