#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// The sky's occlusion (sky_occlusion.h), one direction of it: every cell of
// the ground, seen from that direction over the whole map (a shadow map of
// the terrain and the objects), adds how visible it is, weighted by how much
// that direction faces its ground (the cosine to its normal).

// (a row of 256 cells a group; groups across, then one row a line)
layout(local_size_x = 256) in;

layout(set = TEXTURE_SET, binding = 0) uniform sampler2D height_texture;       // R32F: the ground (m)
layout(set = TEXTURE_SET, binding = 1) uniform sampler2D view_texture;         // the direction's depth (0..1, exact texels)

layout(set = READWRITE_SET, binding = 0, r32f) uniform image2D sum_image;
layout(set = READWRITE_SET, binding = 1, r32f) uniform image2D weight_image;    // the cosines' sum (what it would be with nothing in the way)

layout(std140, set = UNIFORM_SET, binding = 0) uniform accumulate_block
{
	mat4 light_view_projection;    // world to the direction's clip space
	vec4 direction;                // xyz: towards the sky; w: 1 the first (the sums start)
	int map_size;
	float cell_size;
	float lift;                    // meters along the normal (no acne)
	float padding;
};

float height_at(int x, int y)
{
	return texelFetch(height_texture, clamp(ivec2(x, y), ivec2(0), ivec2(map_size - 1)), 0).x;
}

void main()
{
	int x = int(gl_GlobalInvocationID.x);
	int y = int(gl_GlobalInvocationID.y);

	if (x >= map_size || y >= map_size)
	{
		return;
	}
	float height = height_at(x, y);
	vec3 normal = normalize(vec3(height_at(x - 1, y) - height_at(x + 1, y), 2.0 * cell_size, height_at(x, y - 1) - height_at(x, y + 1)));
	float facing = max(dot(direction.xyz, normal), 0.0);
	float seen = 0.0;

	if (facing > 0.0)
	{
		// (lifted more where the direction grazes the ground: across a
		// texel of the depth map the ground's depth changes more there)
		float grazing = min(sqrt(max(1.0 - facing * facing, 0.0)) / facing, 8.0);
		vec3 point = vec3(float(x) * cell_size, height, float(y) * cell_size) + normal * (lift * (1.0 + grazing));
		vec4 clip = light_view_projection * vec4(point, 1.0);
		vec3 position = clip.xyz / clip.w * 0.5 + 0.5;

		// (a texture's first row is its top)
		position.y = 1.0 - position.y;
		// (compared here, the four texels round it blended: a sampler's
		// comparison is not every driver's in a compute shader)
		if (position.x >= 0.0 && position.x <= 1.0 && position.y >= 0.0 && position.y <= 1.0 && position.z <= 1.0)
		{
			ivec2 view_size = textureSize(view_texture, 0);
			vec2 texel = position.xy * vec2(view_size) - 0.5;
			ivec2 corner = ivec2(floor(texel));
			vec2 blend = texel - vec2(corner);
			float seen_00 = position.z <= texelFetch(view_texture, clamp(corner, ivec2(0), view_size - 1), 0).r ? 1.0 : 0.0;
			float seen_10 = position.z <= texelFetch(view_texture, clamp(corner + ivec2(1, 0), ivec2(0), view_size - 1), 0).r ? 1.0 : 0.0;
			float seen_01 = position.z <= texelFetch(view_texture, clamp(corner + ivec2(0, 1), ivec2(0), view_size - 1), 0).r ? 1.0 : 0.0;
			float seen_11 = position.z <= texelFetch(view_texture, clamp(corner + ivec2(1, 1), ivec2(0), view_size - 1), 0).r ? 1.0 : 0.0;

			seen = mix(mix(seen_00, seen_10, blend.x), mix(seen_01, seen_11, blend.x), blend.y);
		}
		else
		{
			seen = 1.0;
		}
	}
	float sum = direction.w > 0.5 ? 0.0 : imageLoad(sum_image, ivec2(x, y)).x;
	float weight = direction.w > 0.5 ? 0.0 : imageLoad(weight_image, ivec2(x, y)).x;

	imageStore(sum_image, ivec2(x, y), vec4(sum + seen * facing, 0.0, 0.0, 0.0));
	imageStore(weight_image, ivec2(x, y), vec4(weight + facing, 0.0, 0.0, 0.0));
}
