#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// The light the land round sends back (sky_occlusion.h), one direction of
// it: for every texel of the ground (bounce_size per side, about a meter),
// where the direction is blocked, which way and how far the thing blocking
// it is. Five sums one under the other (rows k * bounce_size ..): the
// blocked directions' x, y, z and distance, each by how much it is blocked
// and faces the ground, and those weights.

layout(local_size_x = 256) in;

layout(set = TEXTURE_SET, binding = 0) uniform sampler2D height_texture;       // R32F: the ground (m)
layout(set = TEXTURE_SET, binding = 1) uniform sampler2D view_texture;         // the direction's depth (0..1, exact texels)

layout(set = READWRITE_SET, binding = 0, r32f) uniform image2D sums_image;

layout(std140, set = UNIFORM_SET, binding = 0) uniform bounce_block
{
	mat4 light_view_projection;    // world to the direction's clip space
	vec4 direction;                // xyz: towards the sky; w: 1 the first (the sums start)
	int map_size;
	float cell_size;
	float lift;                    // meters along the normal (no acne)
	int bounce_size;               // texels per side
	float depth_range;             // meters the depth map's 0..1 spans
	float padding_1;
	float padding_2;
	float padding_3;
};

float height_at(ivec2 cell)
{
	return texelFetch(height_texture, clamp(cell, ivec2(0), ivec2(map_size - 1)), 0).x;
}

void add(int x, int y, int band, float value)
{
	ivec2 at = ivec2(x, y + band * bounce_size);
	float sum = direction.w > 0.5 ? 0.0 : imageLoad(sums_image, at).x;

	imageStore(sums_image, at, vec4(sum + value, 0.0, 0.0, 0.0));
}

void main()
{
	int x = int(gl_GlobalInvocationID.x);
	int y = int(gl_GlobalInvocationID.y);

	if (x >= bounce_size || y >= bounce_size)
	{
		return;
	}
	float texel_meters = float(map_size) * cell_size / float(bounce_size);
	vec2 spot = (vec2(float(x), float(y)) + 0.5) * texel_meters;
	ivec2 cell = ivec2(floor(spot / cell_size + 0.5));
	float height = height_at(cell);
	// (the normal over the texel's breadth: the land's lie, not a pebble's)
	int reach = max(int(texel_meters / cell_size * 0.5 + 0.5), 1);
	vec3 normal = normalize(vec3(height_at(cell - ivec2(reach, 0)) - height_at(cell + ivec2(reach, 0)), 2.0 * float(reach) * cell_size,
		height_at(cell - ivec2(0, reach)) - height_at(cell + ivec2(0, reach))));
	float facing = max(dot(direction.xyz, normal), 0.0);
	float blocked = 0.0;
	float distance = 0.0;

	if (facing > 0.0)
	{
		float grazing = min(sqrt(max(1.0 - facing * facing, 0.0)) / facing, 8.0);
		vec3 point = vec3(spot.x, height, spot.y) + normal * (lift * (1.0 + grazing));
		vec4 clip = light_view_projection * vec4(point, 1.0);
		vec3 position = clip.xyz / clip.w * 0.5 + 0.5;

		position.y = 1.0 - position.y;
		if (position.x >= 0.0 && position.x <= 1.0 && position.y >= 0.0 && position.y <= 1.0 && position.z >= 0.0 && position.z <= 1.0)
		{
			ivec2 view_size = textureSize(view_texture, 0);
			ivec2 texel = clamp(ivec2(position.xy * vec2(view_size)), ivec2(0), view_size - 1);
			float stored = texelFetch(view_texture, texel, 0).r;

			if (position.z > stored)
			{
				blocked = 1.0;
				distance = (position.z - stored) * depth_range;
			}
		}
	}
	float weight = blocked * facing;

	add(x, y, 0, weight * direction.x);
	add(x, y, 1, weight * direction.y);
	add(x, y, 2, weight * direction.z);
	add(x, y, 3, weight * distance);
	add(x, y, 4, weight);
}
