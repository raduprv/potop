# A farm building for tools/potop_house (workshop 12, the large one)
preset = cottage
workshop = 12
# the village's: 12 by 4 m, a landing, three hatches
crib_size = 2
seed = 13
base_height = 0
chimney = 0
porch = 0
annex = 0
moss = 0.3
lichen = 0.08
wear = 0.5
variants = 0
plaster_tint = 0
# (small and open: nothing hidden to leave out)
interior = 1
roof_meters = 3.5
roof_color_texture = props/textures/house_roof_shingle_dark_color.png
roof_normal_texture = props/textures/house_roof_shingle_dark_normal.png
roof_arm_texture = props/textures/house_roof_shingle_dark_arm.png
timber_meters = 2.7
timber_bands = 1
timber_color_texture = props/textures/hewn_log_dark_color.png
timber_normal_texture = props/textures/hewn_log_dark_normal.png
timber_arm_texture = props/textures/hewn_log_dark_arm.png
walls_meters = 1.2
walls_color_texture = props/textures/house_board_wall_color.png
walls_normal_texture = props/textures/house_board_wall_normal.png
walls_arm_texture = props/textures/house_board_wall_arm.png
base_meters = 1.6
base_color_texture = props/textures/coursed_limestone_color.png
base_normal_texture = props/textures/coursed_limestone_normal.png
base_arm_texture = props/textures/coursed_limestone_arm.png
log_meters = 1.5
log_color_texture = props/textures/house_log_bark_color.png
log_normal_texture = props/textures/house_log_bark_normal.png
log_arm_texture = props/textures/house_log_bark_arm.png
# the corn: the cobs heaped (Radu's tile_corn; its ARM made from the color: the gaps dark and rough)
floor_meters = 2.2
floor_color_texture = props/textures/tile_corn_color.png
floor_normal_texture = props/textures/tile_corn_normal.png
floor_arm_texture = props/textures/tile_corn_arm.png
